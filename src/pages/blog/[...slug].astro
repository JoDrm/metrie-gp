---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, CalendarDays, Clock, Tag, MessageSquare } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import { blogPostingSchema } from '../../lib/schema';
import { services } from '../../siteConfig';
import { formatDate, isoDate, readingTime } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;
const path = `/blog/${post.slug}`;

const breadcrumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: data.title, path },
];

const articleSchema = blogPostingSchema({
  title: data.title,
  description: data.description,
  datePublished: isoDate(data.pubDate),
  dateModified: data.updatedDate ? isoDate(data.updatedDate) : undefined,
  author: data.author,
  image: data.cover,
  path,
});

const minutes = readingTime(post.body);

/* Maillage interne — les articles n'avaient qu'un seul lien sortant chacun,
   ce qui laissait le blog quasi déconnecté du reste du site.
   1. Articles voisins : ceux qui partagent le plus de tags.
   2. Services liés : ceux dont la page cite cet article. */
const others = await getCollection('blog', ({ data, slug }) =>
  slug !== post.slug && (import.meta.env.PROD ? !data.draft : true),
);
const relatedPosts = others
  .map((p) => ({ p, score: p.data.tags.filter((t) => data.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);

const relatedServices = services.filter((s) => s.related.includes(post.slug));
---

<Layout
  title={data.title}
  description={data.description}
  keywords={data.keywords}
  path={path}
  image={data.cover}
  type="article"
  active="/blog"
  breadcrumbs={breadcrumbs}
  extraSchema={articleSchema}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(data.pubDate)} />
    {data.updatedDate && <meta property="article:modified_time" content={isoDate(data.updatedDate)} />}
    {data.tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <main class="page-main legal-page blog-article">
    <section class="block">
      <a href="/blog" class="blog-back"><ArrowLeft size={14} /> Tous les articles</a>

      <header class="blog-article-head">
        <div class="blog-card-meta">
          <time datetime={isoDate(data.pubDate)}><CalendarDays size={13} /> {formatDate(data.pubDate)}</time>
          <span class="blog-dot">·</span>
          <span><Clock size={13} /> {minutes} min de lecture</span>
          {data.tags.map((t) => <span class="blog-tag"><Tag size={11} /> {t}</span>)}
        </div>
        <h1 class="page-title">{data.title}</h1>
        <p class="legal-meta">Par {data.author}{data.updatedDate ? ` · mis à jour le ${formatDate(data.updatedDate)}` : ''}</p>
      </header>

      {data.cover && (
        <div class="blog-article-cover">
          <img src={data.cover} alt={data.coverAlt ?? data.title} />
        </div>
      )}

      <article class="legal-body blog-body">
        <Content />
      </article>

      {relatedServices.length > 0 && (
        <aside class="post-links">
          <h2>Le service correspondant</h2>
          <div class="post-links-grid">
            {relatedServices.map((s) => (
              <a href={`/services/${s.slug}`} class="post-link-card">
                <span class="post-link-num">{s.num}</span>
                <strong>{s.name}</strong>
                <span class="post-link-desc">{s.short}</span>
                <span class="post-link-go">Découvrir <ArrowRight size={14} /></span>
              </a>
            ))}
          </div>
        </aside>
      )}

      {relatedPosts.length > 0 && (
        <aside class="post-links">
          <h2>À lire ensuite</h2>
          <div class="post-links-grid">
            {relatedPosts.map((r) => (
              <a href={`/blog/${r.slug}`} class="post-link-card">
                <time datetime={isoDate(r.data.pubDate)}>{formatDate(r.data.pubDate)}</time>
                <strong>{r.data.title}</strong>
                <span class="post-link-desc">{r.data.description}</span>
              </a>
            ))}
          </div>
        </aside>
      )}

      <div class="flex flex-col gap-4 mt-10 sm:flex-row sm:items-center sm:justify-between">
        <a href="/blog" class="btn-text"><ArrowLeft size={15} /> Retour au blog</a>
        <a href="/contact" class="btn-primary"><MessageSquare size={16} /> Discuter d'un projet</a>
      </div>
    </section>
  </main>
</Layout>
